PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ricozcontract
JWT_SECRET=change-this-to-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Comma-separated list of browser origins allowed to call the API, and the base
# for password-reset links. It must be a bare scheme://host[:port] value with no
# path, and it has to match the deployed frontend exactly.
#
#   production (Render)  : https://ricoz-contract-clm-platform.vercel.app
#   local development     : http://localhost:3000
#
# If the browser sends a cross-origin preflight and this value is missing or
# wrong, the response carries no Access-Control-Allow-Origin header and requests
# fail with a CORS error. Verify with: npm run release:verify
CLIENT_URL=http://localhost:3000
# Supabase Storage (private bucket). SUPABASE_SECRET_KEY must be the secret key,
# never the publishable/anon key. Set real values only in the server environment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=set-this-only-in-the-server-environment
SUPABASE_BUCKET_NAME=contract-documents
# Password-reset email. Resend is the primary transport (a single HTTPS API
# call, so an outbound-SMTP block on the host cannot stop delivery) and is used
# whenever RESEND_API_KEY is set. Never commit real values.
#
# RESEND_API_KEY is the sending API key from the Resend dashboard. It is NOT the
# publishable key and NOT the signing key. Anything without the re_ prefix is
# rejected by the API with HTTP 401.
RESEND_API_KEY=
# How long a single Resend call may take before it is abandoned so the SMTP
# fallback can run. Optional; defaults to 10000 milliseconds.
# RESEND_TIMEOUT_MS=10000
# The verified sender every Resend email is sent from. Required with Resend
# (Resend refuses any other address) and used as the sender for SMTP too.
# Format: "RicozContract <no-reply@your-verified-domain.com>"
EMAIL_FROM=RicozContract <no-reply@example.com>
# Optional SMTP fallback. Only used when RESEND_API_KEY is absent, or when a
# Resend send fails. It can be deleted entirely; the mailer does not require it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
