# SMTP / email (used to send password-reset links). Never commit real values.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=RicozContract <no-reply@example.com>
